// Copy this file to src/secrets.h (gitignored) and fill in your values.
#pragma once

// Your numeric EcoFlow account user id — NOT your email. The device only
// accepts clients that present the MD5 of (user_id + serial number), and it
// learned your user_id when you paired it with the EcoFlow app.
// Run tools/get_user_id.py to fetch it:
//   python3 tools/get_user_id.py you@example.com
#define ECOFLOW_USER_ID "1234567890123456789"

// Optional: lock onto one specific unit by full 16-char serial number
// (shown in the EcoFlow app, or in this firmware's serial log during scan).
// Leave empty to connect to the first River 2 / Max / Pro found.
#define ECOFLOW_DEVICE_SN ""
